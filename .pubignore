# When .pubignore exists it replaces .gitignore for publishing.
# Keep this in sync with .gitignore, plus extra publish-only excludes.

# Tooling / build
.dart_tool/
.packages
build/
**/build/
pubspec.lock
.flutter-plugins
.flutter-plugins-dependencies
coverage/
*.log
.DS_Store

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# Example local / generated
example/.dart_tool/
example/build/
example/.flutter-plugins
example/.flutter-plugins-dependencies
example/ios/Pods/
example/ios/.symlinks/
example/ios/Flutter/Flutter.framework
example/ios/Flutter/Flutter.podspec
example/ios/Flutter/Generated.xcconfig
example/ios/Flutter/ephemeral/
example/ios/ServiceDefinitions.json
example/macos/Flutter/ephemeral/
example/linux/flutter/ephemeral/
example/windows/flutter/ephemeral/
example/android/.gradle/
example/android/local.properties
example/android/**/gradle-wrapper.jar
example/android/captures/
